apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_name }}-credentials
  namespace: rhdg-poc
type: Opaque
stringData:
  identities.yaml: |-
    credentials:
      - username: app-{{ cluster_name }}
        password: {{ app_password | default('changeme') }}
        roles:
          - application
      - username: ops-admin
        password: {{ admin_password | default('changeme') }}
        roles:
          - admin
